# Copiez ce fichier en .env et adaptez les valeurs. NE JAMAIS committer
# le fichier .env lui-meme (il contient des secrets).

DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_MOI@localhost:5432/plateforme_securisee
# Générez une vraie valeur aléatoire, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_MOI_avec_une_vraie_valeur_aleatoire_64_hex
JWT_EXPIRES_HOURS=8
FRONTEND_URL=http://localhost:5173

# Hôte/port d'écoute du serveur de développement (run.py). Ne JAMAIS
# mettre 0.0.0.0 avec FLASK_DEBUG=1 en dehors d'un poste isolé.
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
# Mode debug Flask (rechargement à chaud, traces d'erreur détaillées).
# Sans rapport avec l'exposition du lien d'activation (voir plus bas).
FLASK_DEBUG=0

# Taille maximale d'une requête / d'un fichier uploadé, en mégaoctets.
MAX_CONTENT_LENGTH_MB=60

# Limitation de débit (flask-limiter). Désactiver seulement pour des
# tests automatisés qui font délibérément beaucoup de requêtes rapides.
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# DANGER : expose le lien d'activation / de renvoi d'invitation dans
# la réponse JSON de l'API (pratique pour tester sans vrai serveur
# SMTP). À laisser à "0" partout sauf sur un poste de développement
# strictement local. Indépendant de FLASK_DEBUG (contrairement à la
# version précédente de ce projet, où le lien fuyait dès que
# FLASK_DEBUG n'était pas explicitement mis à 0).
EXPOSE_ACTIVATION_LINK_DEV=0

# SMTP (optionnel) : si SMTP_HOST est vide, les emails (invitation et
# notifications de sécurité) sont affichés dans les logs du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@plateforme-securisee.local
